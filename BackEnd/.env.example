DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-esta-chave-em-producao-minimo-32-bytes
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Conexão PostgreSQL (obrigatório)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/escola
# Ou variáveis individuais:
# DB_NAME=escola
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Origens permitidas para o painel React (separadas por vírgula)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Chave mestra AES-256-GCM para criptografia biométrica e PII (LGPD).
# Gere em produção com: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BIOMETRIC_MASTER_KEY=
BIOMETRIC_KEY_ID=k1
# Chaves antigas para rotação (JSON opcional): {"k0": "chave-antiga-base64"}
BIOMETRIC_PREVIOUS_KEYS={}

# Autenticação
AUTH_TOKEN_TTL_HOURS=12
DEMO_LOGIN=0

# Chave de desenvolvimento para o dispositivo padrão da portaria (criada pelo seed_mock)
PORTARIA_DEV_KEY=portaria-dev-key-2026-trocar-em-producao
